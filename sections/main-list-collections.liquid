<section class="section">
  <div class="wrap page">
    <h1>{{ section.settings.heading | escape }}</h1>
    <div class="grid-cats">
      {%- for collection in collections -%}
        <a class="cat-card" href="{{ collection.url }}">
          {%- if collection.image -%}
            {{ collection.image | image_url: width: 1000 | image_tag: alt: collection.title, loading: 'lazy' }}
          {%- else -%}
            <img src="{{ 'cat-boys.jpg' | asset_url }}" alt="" width="900" height="1200">
          {%- endif -%}
          <span class="cat-card__label glass">
            <strong>{{ collection.title }}</strong>
            <small>{{ collection.products_count }} pieces</small>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ],
  "presets": [{ "name": "Collections list" }]
}
{% endschema %}
