<footer class="footer">
  <div class="wrap">
    <div class="footer__panel glass">
      <div>
        <p class="logo__name">{{ settings.logo_text | escape }}</p>
        {%- if settings.show_tagline -%}
          <p class="logo__tag">{{ settings.tagline | escape }}</p>
        {%- endif -%}
        <p class="footer__address">{{ settings.address | newline_to_br }}</p>
        <a class="footer__phone" href="https://wa.me/{{ settings.whatsapp_number | escape }}" target="_blank" rel="noopener">
          {{ settings.phone_display | escape }}
        </a>
      </div>
      <div>
        <h2 class="footer__heading">Shop</h2>
        <div class="footer__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'shop_link' -%}
              <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div>
        <h2 class="footer__heading">Info</h2>
        <div class="footer__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'info_link' -%}
              <a href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div>
        <h2 class="footer__heading">Delivery</h2>
        <p>Free shipping over Rs. {{ settings.free_shipping_threshold }}</p>
        <p class="note">Delivery in {{ settings.shipping_time }}</p>
      </div>
    </div>
    <p class="legal">© {{ 'now' | date: '%Y' }} {{ settings.logo_text | escape }}. Orders are confirmed on WhatsApp.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "shop_link",
      "name": "Shop link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Kids Boys" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "type": "info_link",
      "name": "Info link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "About" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Footer" }
  ]
}
{% endschema %}
